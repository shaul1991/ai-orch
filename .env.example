# Copy this file to .env and adjust provider/model routing per project or per developer.
#
# .env is ignored by git.
# .env.example is committed as the shared template.
#
# Supported format:
# KEY=value
#
# Values passed directly in the shell take precedence over .env.
# Example:
# AI_CODE_PROVIDER=claude-code AI_CODE_MODEL=default scripts/sdd-implement.sh sample-feature

# Documentation, research, summaries
AI_DOC_PROVIDER=codex-acp
AI_DOC_MODEL=gpt-5.5

# Architecture planning
AI_ARCH_PROVIDER=claude-code
AI_ARCH_MODEL=default

# Coding, refactoring, tests
AI_CODE_PROVIDER=claude-code
AI_CODE_MODEL=default

# Self-review and PR draft
AI_REVIEW_PROVIDER=claude-code
AI_REVIEW_MODEL=default

# GitHub CLI integration
#
# If the repository has an origin remote, GH_REPO can be omitted.
# If there is no origin remote, set AI_GITHUB_REPO explicitly:
# AI_GITHUB_REPO=owner/shaul-ai-orch
AI_GITHUB_BASE_BRANCH=main
AI_GITHUB_ISSUE_LIMIT=20
AI_GITHUB_PR_LIMIT=20
