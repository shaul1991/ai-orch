# OS and editor state
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
/.vscode/
/.idea/
/vscode/

# Local environment and secrets
.env
.env.*
.direnv/

# AI assistant local state
# Keep .claude-plugin/**, .agents/plugins/**, and plugin manifests tracked.
/.claude/
/.codex/
/.ai-orch/*
!/.ai-orch/
!/.ai-orch/README.md
!/.ai-orch/init.json
!/.ai-orch/setting.json
!/.ai-orch/settings.example.json

# Local notes, logs, and temporary files
/.local/
/.log/
/logs/
/tmp/
/temp/
*.log
*.tmp
*.temp

# Spec Kit local runtime state.
# Keep .specify/memory/** tracked.
/.specify/cache/
/.specify/logs/

# OpenCode local install artifacts.
# Keep .opencode/oh-my-openagent.jsonc and .opencode/skills/** tracked.
/.opencode/node_modules/
/.opencode/package.json
/.opencode/package-lock.json
/.opencode/bun.lock
/.opencode/.gitignore

# JavaScript and package-manager caches
node_modules/
.pnp.*
.bun/
.cache/
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/sdks/
!.yarn/versions/

# Python caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.coverage
.venv/
venv/

# Build, test, and coverage outputs
dist/
build/
out/
target/
coverage/
htmlcov/
